# ==========================================================================
# BharatBid on Vercel — Production / Preview environment variables
# Set these in Vercel → Project → Settings → Environment Variables.
# Names and placeholders only. NEVER commit real values. See docs/VERCEL_DEPLOYMENT.md.
# ==========================================================================

NODE_ENV=production
APP_NAME=BharatBid
# Your production domain (no trailing slash). Same origin serves the SPA and /api.
APP_URL=https://your-domain.vercel.app
FRONTEND_URL=https://your-domain.vercel.app
CORS_ORIGINS=https://your-domain.vercel.app
LOG_LEVEL=info
# Leave empty: the SPA calls same-origin /api (vercel.json rewrites).
VITE_API_URL=

# --- PostgreSQL (Neon / Supabase / RDS). Use the POOLED URL for the runtime. ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true
DATABASE_POOL_MAX=3
DATABASE_POOL_TIMEOUT_SECONDS=10

# --- Redis (Upstash, TLS). Required in production: OTP, token revocation, rate limits, idempotency. ---
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JOBS_MODE=inline

# --- Auth secrets (>= 32 chars each; generate: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
STORAGE_SIGNING_SECRET=
AUTH_BCRYPT_COST=12
AUTH_DEMO_MODE=false
AUTH_PASSWORD_LOGIN=false
# Real OTP delivery. "mock" is only accepted in production alongside DEMO_MODE — never use it here.
OTP_PROVIDER=auto

# --- Google Identity Services (popup / ID token; no redirect URI) ---
GOOGLE_CLIENT_ID=

# --- Email OTP (SMTP) ---
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=BharatBid

# --- Mobile OTP (MSG91, backend only) ---
SMS_ENABLED=true
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Storage: private, auth-proxied bytes in PostgreSQL (or s3 + AWS_* below) ---
STORAGE_PROVIDER=postgres
# Vercel request bodies are capped at 4.5 MB.
DOCUMENT_MAX_BYTES=4194304
STORAGE_MAX_BYTES=4194304
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# --- AI (optional). Leave off unless GEMINI_API_KEY is set. ---
AI_ENABLED=false
FEATURE_AI=false
# GEMINI_API_KEY=

# --- Hackathon demo: synthetic CPCL tenders + DEMO SOURCE verification adapters ---
# DEMO_MODE labels every adapter result DEMO / SYNTHETIC. It does NOT mock auth (AUTH_DEMO_MODE=false).
DEMO_MODE=true
ALLOW_DEMO_IN_PRODUCTION=true
SEED_DEMO_PASSWORDS=false
# true: every verified sign-up (email/mobile OTP or Google) becomes procurement_officer in the synthetic demo
# tenant so judges can explore. Set false before any real procurement data is loaded.
DEMO_PROVISION_NEW_USERS=true

# --- Live verification providers (optional; absent = DEMO / configuration required) ---
# GST_API_BASE_URL= GST_CLIENT_ID= GST_CLIENT_SECRET= GST_API_MODE=sandbox
# PAN_API_BASE_URL= PAN_CLIENT_ID= PAN_CLIENT_SECRET= PAN_API_MODE=sandbox
