NODE_ENV=test
PORT=5000
HOST=127.0.0.1
APP_NAME=BharatBid
LOG_LEVEL=silent
DEMO_MODE=true
AI_ENABLED=false
FEATURE_AI=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hackathon_test
DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT_SECONDS=10
JWT_ACCESS_SECRET=test-access-secret-not-for-production-32
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-32
JWT_ISSUER=test-issuer
JWT_AUDIENCE=test-audience
AUTH_BCRYPT_COST=4
AUTH_DEFAULT_ROLE=user
RATE_LIMIT_ENABLED=true
# Optional. Enables Redis KV and BullMQ integration tests when Redis is running.
# REDIS_URL=redis://localhost:6379
