# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=BharatBid
# Display name only. This is not an official Government of India product.
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb

# Frontend (optional; leave empty to use the Vite / nginx proxy)
VITE_API_URL=

# ==========================================
# DOCKER (local Compose interpolation only)
# ==========================================

# Host-based `npm run dev` uses DATABASE_URL / REDIS_URL with 127.0.0.1 below
# (avoids Windows localhost → IPv6 issues). Docker Compose overrides these
# inside containers to service names (postgres, redis).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
SEED_ON_START=true

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/hackathon
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://127.0.0.1:6379
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=200
JOB_TIMEOUT_MS=60000
# Compose sets this per service. Unset for local `npm run dev` so the API consumes jobs.
# JOBS_PROCESS=true
# queue (default): Redis/BullMQ or file queue + worker. inline: each job finishes inside the request
# (required on Vercel — there is no long-lived worker process).
JOBS_MODE=queue

# ==========================================
# AUTHENTICATION
# ==========================================

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bharatbid-ai
JWT_AUDIENCE=bharatbid-ai-api

AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=72
AUTH_PASSWORD_REQUIRE_UPPERCASE=false
AUTH_PASSWORD_REQUIRE_LOWERCASE=false
AUTH_PASSWORD_REQUIRE_NUMBER=false
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_BCRYPT_COST=12
AUTH_DEFAULT_ROLE=user
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_IP_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW=15m
# Password sign-in (POST /auth/login). Default: on outside production, off in production.
# AUTH_PASSWORD_LOGIN=
# Seed demo users with the shared password `demo-password`. Default: on outside production, off in production.
# SEED_DEMO_PASSWORDS=

# ==========================================
# AI
# ==========================================

AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=

AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=200

# ==========================================
# EMAIL
# ==========================================

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_TIMEOUT_MS=10000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

RESEND_API_KEY=
BREVO_API_KEY=

# ==========================================
# SMS
# ==========================================

SMS_ENABLED=false
SMS_PROVIDER=mock

SMS_API_KEY=
SMS_FROM=
SMS_HTTP_URL=
SMS_TIMEOUT_MS=10000

# MSG91 OTP (backend only — never expose as VITE_*)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_WIDGET_ID=

# ==========================================
# OTP
# ==========================================

OTP_PROVIDER=auto
OTP_DIGITS=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_RATE_LIMIT_MAX=5
OTP_IP_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW=15m
OTP_HASH_SECRET=

# Google Identity Services (ID token audience). Never put GOOGLE_CLIENT_SECRET in VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==========================================
# STORAGE
# ==========================================

# local (default): disk + PostgreSQL dual-write when DATABASE_URL is set
# postgres: stored_objects only (shared across hosts that share the DB)
# s3: AWS S3 (private bucket; not required for local development)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
STORAGE_MAX_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRES=300
# Optional HMAC secret for local/postgres signed downloads. Falls back to JWT_ACCESS_SECRET.
# STORAGE_SIGNING_SECRET=

DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_TEXT_CHARS=100000
DOCUMENT_CONFIDENCE_THRESHOLD=0.7
DOCUMENT_ASYNC_THRESHOLD_BYTES=1048576

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==========================================
# SECURITY
# ==========================================

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1m
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW=15m
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_MAX=120
RATE_LIMIT_AUTHENTICATED_WINDOW=1m
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_ADMIN_WINDOW=1m
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_IP_RATE_LIMIT_MAX=20
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW=15m

# ==========================================
# DEMO
# ==========================================

DEMO_MODE=true
# Mocks OTP / email / SMS delivery. Never inherited from DEMO_MODE in production; keep false there.
AUTH_DEMO_MODE=false
# Production refuses DEMO_MODE unless this is also true. Never set it on a real tenant.
# ALLOW_DEMO_IN_PRODUCTION=false
# With DEMO_MODE, new sign-ups get procurement_officer + the seeded demo tenant (skipped if it is not seeded).
# Default: on with DEMO_MODE (off under NODE_ENV=test). Set false to give new accounts only AUTH_DEFAULT_ROLE.
# DEMO_PROVISION_NEW_USERS=

# ==========================================
# FEATURE FLAGS
# ==========================================

FEATURE_AI=true
FEATURE_NOTIFICATIONS=true
FEATURE_OTP=true
FEATURE_SMS=false
FEATURE_S3=false
FEATURE_PDF=true

# ==========================================
# VERIFICATION PROVIDERS (backend only — never expose to Vite / VITE_*)
# Do not commit real secrets. Empty values mean READY_FOR_CREDENTIALS or DEMO fallback.
# Sandbox and production credentials must never be mixed. GST_API_MODE=sandbox is SANDBOX, not LIVE.
# Catalog never shows LIVE from env alone. LIVE badges appear only after a successful authorized HTTPS lookup
# that is stored as a fresh (non-cached) verification row.
# ==========================================

# Sandbox (authorized provider sandbox hosts and keys)
GST_API_BASE_URL=
GST_CLIENT_ID=
GST_CLIENT_SECRET=
GST_PRODUCT_INSTANCE_ID=
GST_API_PATH=/api/gstin/{identifier}
GST_API_METHOD=GET
GST_API_MODE=sandbox

PAN_API_BASE_URL=
PAN_CLIENT_ID=
PAN_CLIENT_SECRET=
PAN_API_PATH=/api/pan/{identifier}
PAN_API_METHOD=GET
PAN_API_MODE=sandbox

# Production live credentials: set GST_API_MODE=live / PAN_API_MODE=live AND replace the values above
# with production Setu (or other authorized) credentials. Do not reuse sandbox keys in live mode.

MCA_API_BASE_URL=
MCA_CLIENT_ID=
MCA_CLIENT_SECRET=

UDYAM_API_BASE_URL=
UDYAM_CLIENT_ID=
UDYAM_CLIENT_SECRET=

DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

ENTITYLOCKER_CLIENT_ID=
ENTITYLOCKER_CLIENT_SECRET=
ENTITYLOCKER_REDIRECT_URI=

GEM_API_BASE_URL=
GEM_CLIENT_ID=
GEM_CLIENT_SECRET=

# OCR extracts candidate text only. HTTPS required. Never treated as government-verified identity.
OCR_HTTP_URL=
OCR_API_KEY=

# ==========================================
# SCHEDULER
# ==========================================

# Off by default. Enable only if interval/cron ticks are required.
# SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=1m
SCHEDULER_POLL=1s